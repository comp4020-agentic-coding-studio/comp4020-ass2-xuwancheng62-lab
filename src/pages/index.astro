---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="An abstract geometric composition on warm cream: a large warm-gold form and a black circle overlapping at right, a small muted dark-green square isolated at lower left, joined by a thin baseline"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Direct your own short film across the whole semester, week by week:
    story, shot design, performance, editing rhythm and sound. Each week's
    technique is first demonstrated on this course's own worked example,
    "Before It Stops," before you turn it on your film. Each week you give a
    director's note, generate against it, judge the result, and redirect —
    the same loop whether the performer on the other end is a human actor or
    a model. You walk out with a finished 2–4 minute film of your own and
    the habit of directing generative tools with the same precision you'd
    bring to a human cast and crew.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who wants to practice directing — not prompting — and is willing
    to treat a generated take the way a director treats a human one: judged
    against an intention, not against how good it happens to look. No prior
    filmmaking or AI-tooling experience is assumed; what matters is a
    willingness to keep giving notes until a take actually matches what you
    meant.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching workshop.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
